{
  "name": "midnight-helixctw",
  "version": "0.1.0",
  "private": true,
  "description": "HelixCTW TestWired private agent memory on CockroachDB, AWS, and Midnight.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/mock-pillars",
    "packages/protocol-types"
  ],
  "scripts": {
    "test": "npm run test:repository && npm run test:workspaces && npm run test:infrastructure",
    "test:repository": "node scripts/verify-fixtures.mjs && node scripts/verify-doc-links.mjs",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:infrastructure": "node --test infrastructure/aws/test/template-contract.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm test && npm run typecheck && npm run build",
    "web:dev": "npm run dev --workspace @midnight-helixctw/judge-web",
    "web:preview": "npm run preview --workspace @midnight-helixctw/judge-web",
    "infra:validate": "bash infrastructure/aws/scripts/validate-local.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
