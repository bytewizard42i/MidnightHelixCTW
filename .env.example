# Public TestWired configuration. Never put real credentials in this file.
MHELIX_STAGE=testwired
MHELIX_SYNTHETIC_DATA_ONLY=true
MHELIX_FAIL_CLOSED=true

# CockroachDB Cloud
COCKROACH_DATABASE_URL=postgresql://test_user:replace-me@example.cockroachlabs.cloud:26257/mhelix_testwired?sslmode=verify-full
COCKROACH_RUNTIME_MODE=testwired

# AWS
AWS_REGION=us-east-1
BEDROCK_TEXT_MODEL_ID=replace-with-approved-profile-or-model
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1

# Midnight test infrastructure
MIDNIGHT_NETWORK=replace-with-current-supported-test-network
MIDNIGHT_RPC_URL=https://replace.example
MIDNIGHT_INDEXER_URL=https://replace.example
MIDNIGHT_PROOF_SERVER_URL=https://replace.example

# Pinned public TestTown source used only by the optional sync verifier.
TESTTOWN_SOURCE_COMMIT=f145c07b3f8abf62c04e1532f67118b5a5aa66b9
