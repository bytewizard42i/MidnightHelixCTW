# Indexer environment for the LOCAL disposable devnet only.
#
# SAFETY: every value below is a published development-only placeholder taken
# from the official Midnight documentation / midnight-local-dev repository.
# None of these are real credentials, and this stack only listens on
# 127.0.0.1. Never reuse any of these values in a deployed environment.

# Where the indexer finds the node (Docker service-name DNS, not localhost).
APP__INFRA__NODE__URL=ws://node:9944

# Internal storage passwords for the indexer's own embedded databases.
# Dev-only placeholders from the official example compose.
APP__INFRA__STORAGE__PASSWORD=indexer
APP__INFRA__PUB_SUB__PASSWORD=indexer
APP__INFRA__LEDGER_STATE_STORAGE__PASSWORD=indexer

# Dev-only hex placeholder from the official example compose (it is the
# ASCII string "0123456789..." repeated — deliberately not secret).
APP__INFRA__SECRET=303132333435363738393031323334353637383930313233343536373839303132

# Required since indexer-standalone 4.3.3 (bundled spo-indexer). Any
# non-empty Blockfrost id works locally when SPO features are unused.
APP__INFRA__SPO_NODE__URL=ws://node:9944
APP__INFRA__SPO_NODE__BLOCKFROST_ID=local-dev-dummy-id
