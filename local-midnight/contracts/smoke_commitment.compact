// MidnightHelixCTW smoke contract — LOCAL TRANSACTION CANARY ONLY.
//
// The smallest useful loop-prover: record one opaque 32-byte value and
// count how many have been recorded. In this test flow the bytes are
// generated randomly by the smoke driver itself.
//
// Honest limits (read before reusing this shape):
// - This circuit is PERMISSIONLESS and LOCAL-ONLY. It proves that the
//   toolchain, deployment, transaction, and ledger-readback path work.
// - Compact enforces the ledger transition for whatever bytes it
//   receives; it CANNOT prove that caller-supplied bytes were honestly
//   randomized, safe, authorized, or a cryptographic commitment to any
//   private data.
// - This is NOT private DID (Decentralized Identifier) authorization and
//   NOT production privacy. Never supply sensitive data to this canary.

pragma language_version >= 0.22 && <= 0.23;

import CompactStandardLibrary;

// Total number of commitments recorded (public, monotonically increasing).
export ledger commitmentCount: Counter;

// The most recently recorded 32-byte commitment (public, opaque).
export ledger latestCommitment: Bytes<32>;

// Record one opaque 32-byte value on the public ledger.
// Circuit parameters are private (witness) data by default in Compact, so
// writing the parameter to a public ledger field requires an explicit
// disclose(), which documents that publishing is intentional. In this
// canary the driver supplies random bytes; the contract cannot verify
// that property — callers must never pass sensitive data here.
export circuit recordCommitment(commitment: Bytes<32>): [] {
  latestCommitment = disclose(commitment);
  commitmentCount.increment(1);
}
